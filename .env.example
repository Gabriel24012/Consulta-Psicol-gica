NODE_ENV=development
PORT=3000

# Frontend origins
WEB_ORIGIN=http://localhost:4200
WEB_PUBLIC_URL=http://localhost:4200

# Database
MONGODB_URI=mongodb+srv://USER:PASSWORD@HOST/DATABASE?retryWrites=true&w=majority

# JWT
JWT_ACCESS_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-another-long-random-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Field-level encryption
FIELD_ENCRYPTION_KEY=replace-with-a-32-byte-base64-key

# Initial admin user / password reset scripts
ADMIN_EMAIL=admin@consulta.local
ADMIN_PASSWORD=ChangeMe123!
ADMIN_NAME=Psicologo Administrador
ADMIN_PHONE=+520000000000

# Redis / queues
REDIS_HOST=localhost
REDIS_PORT=6379

# Appointment settings
APPOINTMENT_TIMEZONE=America/Mexico_City
APPOINTMENT_LOCATION=ubicacion del consultorio por confirmar
ALLOW_APPOINTMENT_DELETE_ALL=false

# Materials
MATERIALS_UPLOAD_DIR=apps/api/uploads/materials

# WhatsApp
WHATSAPP_MODE=mock
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=replace-with-webhook-verify-token
WHATSAPP_GRAPH_API_VERSION=v25.0
WHATSAPP_APPOINTMENT_REMINDER_TEMPLATE=appointment_reminder
WHATSAPP_TEMPLATE_LANGUAGE=es_MX
